<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#F8F9FA"
        app:contentInsetStart="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="20dp">

            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="POPKRAF"
                    android:textColor="#B71C1C"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beranda"
                    android:textColor="#424242"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="110dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp">

            <TextView
                android:id="@+id/tvSapaan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_extrabold"
                android:text="Halo, Kreator! 👋"
                android:textColor="@color/deep_ink"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/nunito_regular"
                android:text="Mau eksplor event apa hari ini?"
                android:textColor="@color/secondary_text"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#EBEDFF"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cobalt_blue">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="5dp"
                    android:drawableStart="@drawable/ic_lokasi"
                    android:drawableTint="@color/cobalt_blue"
                    android:gravity="center_vertical"
                    android:fontFamily="@font/nunito_bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="Pekanbaru, Riau ⌄"
                    android:textColor="@color/deep_ink"
                    android:textSize="12sp" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#F0F0F0"
                    app:strokeWidth="1dp">

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:drawableStart="@android:drawable/ic_menu_search"
                        android:drawablePadding="12dp"
                        android:drawableTint="#705D59"
                        android:fontFamily="@font/nunito_regular"
                        android:hint="Cari event, lokasi, atau tenant..."
                        android:paddingHorizontal="16dp"
                        android:textSize="13sp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnFilter"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="12dp"
                    app:cardBackgroundColor="@color/sun_yellow"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/deep_ink" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/scrollChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/etSearch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupKategori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="false"
                    app:chipSpacingHorizontal="12dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBazar"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bazar"
                        android:textColor="@color/deep_ink"
                        android:fontFamily="@font/nunito_black"
                        android:textStyle="bold"
                        android:checkable="true"
                        app:checkedIconVisible="true"
                        app:chipBackgroundColor="@color/sun_yellow"
                        app:chipCornerRadius="20dp"
                        app:chipMinHeight="40dp"
                        app:textStartPadding="16dp"
                        app:textEndPadding="16dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMusik"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Musik"
                        android:fontFamily="@font/nunito_black"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:checkable="true"
                        app:checkedIconVisible="true"
                        app:chipBackgroundColor="@color/cobalt_blue"
                        app:chipCornerRadius="20dp"
                        app:chipMinHeight="40dp"
                        app:textStartPadding="16dp"
                        app:textEndPadding="16dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPameran"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pameran"
                        android:textColor="@color/white"
                        android:fontFamily="@font/nunito_black"
                        android:textStyle="bold"
                        android:checkable="true"
                        app:checkedIconVisible="true"
                        app:chipBackgroundColor="@color/coral"
                        app:chipCornerRadius="20dp"
                        app:chipMinHeight="40dp"
                        app:textStartPadding="16dp"
                        app:textEndPadding="16dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFestival"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Festival"
                        android:textColor="@color/deep_ink"
                        android:fontFamily="@font/nunito_black"
                        android:textStyle="bold"
                        android:checkable="true"
                        app:checkedIconVisible="true"
                        app:chipBackgroundColor="@color/sun_yellow"
                        app:chipCornerRadius="20dp"
                        app:chipMinHeight="40dp"
                        app:textStartPadding="16dp"
                        app:textEndPadding="16dp"/>


                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="#F0F0F0"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="20dp">

                    <ImageView
                        android:id="@+id/ivEventImage"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="#E0E0E0"
                        android:scaleType="centerCrop"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/event_pku"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="12dp"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_bold"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="BAZAR"
                                android:textColor="#20263A"
                                android:textSize="10sp" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="12dp"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_bold"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="UMKM"
                                android:textColor="#20263A"
                                android:textSize="10sp" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="12dp"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_bold"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="MUSIK"
                                android:textColor="#20263A"
                                android:textSize="10sp" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:strokeWidth="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="6dp"
                            android:src="@drawable/heart"
                            app:tint="@color/coral" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="#FFD95A"
                        app:cardCornerRadius="14dp"
                        app:layout_constraintBottom_toBottomOf="@+id/ivEventImage"
                        app:layout_constraintStart_toStartOf="parent"
                        app:strokeWidth="0dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:text="🔥 MULAI 02:14:36"
                            android:textColor="#20263A"
                            android:textSize="10sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="#E8EAF6"
                        app:cardCornerRadius="14dp"
                        app:layout_constraintBottom_toBottomOf="@+id/ivEventImage"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:strokeWidth="0dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:text="🏪 80+ Tenants"
                            android:textColor="#1976D2"
                            android:textSize="10sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvLocationEvent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/nunito_bold"
                        android:text="📍 Bandar Seni Raja Ali Haji"
                        android:textColor="#1976D2"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ivEventImage" />

                    <TextView
                        android:id="@+id/tvEventTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/nunito_extrabold"
                        android:text="Riau Creative Fest 2026"
                        android:textColor="#20263A"
                        android:textSize="18sp"
                        app:layout_constraintTop_toBottomOf="@+id/tvLocationEvent" />

                    <TextView
                        android:id="@+id/tvEventDateTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/nunito_regular"
                        android:text="📅 12 Okt 2026   ⏰ 09.00–20.00 WIB"
                        android:textColor="#705D59"
                        android:textSize="12sp"
                        app:layout_constraintTop_toBottomOf="@+id/tvEventTitle" />

                    <TextView
                        android:id="@+id/tvLabelHarga"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/nunito_extrabold"
                        android:text="TIKET MASUK"
                        android:textColor="#705D59"
                        android:textSize="10sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvEventDateTime" />

                    <TextView
                        android:id="@+id/tvEventPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_extrabold"
                        android:text="Mulai Rp 25.000"
                        android:textColor="#1976D2"
                        android:textSize="20sp"
                        app:layout_constraintStart_toStartOf="@+id/tvLabelHarga"
                        app:layout_constraintTop_toBottomOf="@+id/tvLabelHarga" />

                    <Button
                        android:id="@+id/btnLihatEvent"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="16dp"
                        android:fontFamily="@font/nunito_bold"
                        android:text="Lihat Event"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:backgroundTint="#FF6B6B"
                        app:layout_constraintBottom_toBottomOf="@+id/tvEventPrice"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tvLabelHarga" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="15dp"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:background="@color/lilac">

                <ImageView
                    android:id="@+id/ivMegaphone"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@color/sun_yellow"
                    android:padding="10dp"
                    android:src="@drawable/ic_announcement"
                    app:tint="@color/deep_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:id="@+id/tvTenantTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:text="Punya Event atau Tenant?"
                        android:textColor="@color/deep_ink"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTenantSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_regular"
                        android:text="Buka lapak kreasimu di PopKraf !"
                        android:textColor="@color/secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnDaftarTenant"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:fontFamily="@font/nunito_bold"
                    android:text="Daftar"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:backgroundTint="@color/deep_ink" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>