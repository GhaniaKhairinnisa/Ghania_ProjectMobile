<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <!-- GAMBAR EVENT -->
    <ImageView
        android:id="@+id/ivEventPic"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:contentDescription="Foto Event"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- NAMA EVENT -->
    <TextView
        android:id="@+id/tvEventName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:text="Nama Event"
        android:textColor="@color/deep_ink"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/ivEventPic"
        app:layout_constraintEnd_toStartOf="@id/cardFavorite"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- LOKASI EVENT -->
    <TextView
        android:id="@+id/tvEventLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:text="Lokasi Event"
        android:textColor="@color/secondary_text"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/ivEventPic"
        app:layout_constraintEnd_toStartOf="@id/cardFavorite"
        app:layout_constraintTop_toBottomOf="@id/tvEventName" />

    <!-- TOMBOL FAVORIT -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFavorite"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivFavorite"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp"
            android:src="@drawable/heart"
            app:tint="@android:color/darker_gray" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
