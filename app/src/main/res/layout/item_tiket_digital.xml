<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNamaEventTiket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Event"
            android:textColor="#212121"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvTanggalEventTiket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tanggal Event"
            android:textColor="#757575"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLokasiEventTiket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Lokasi Event"
            android:textColor="#757575"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvJenisTiket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FCE4EC"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Tiket Regular"
            android:textColor="#B71C1C"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/ivQrTiket"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:contentDescription="QR Code tiket digital"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvKodeTiket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Kode tiket"
            android:textColor="#424242"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvStatusTiket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="TIKET AKTIF"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
