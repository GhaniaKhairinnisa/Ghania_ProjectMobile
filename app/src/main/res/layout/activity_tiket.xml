<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FF"
    tools:context=".Tiket.TiketActivity">

    <!-- HEADER DETAIL TIKET -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#F8F7FF"
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvTitleToolbarTiket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/nunito_extrabold"
                android:text="Detail Tiket"
                android:textColor="#20263A"
                android:textSize="16sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/btnShareTiket"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_share"
                android:contentDescription="Bagikan"
                android:layout_marginEnd="16dp"
                app:tint="#20263A"
                app:layout_constraintEnd_toStartOf="@id/ivProfileTiket"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/ivProfileTiket"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_profil"
                android:scaleType="centerCrop"
                android:contentDescription="Profil"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- KONTEN DETAIL TIKET -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollTiket"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/btnBayarSekarang"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- RINGKASAN EVENT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEventTiket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F1F0FF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E4E1FA"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/ivPosterTiket"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/event1"
                        android:scaleType="centerCrop"
                        android:contentDescription="Poster event" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNamaEventTiket"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="Nama Event"
                            android:textColor="#20263A"
                            android:textSize="15sp"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tvKategoriEventTiket"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_regular"
                            android:text="Festival Kreatif"
                            android:textColor="#705D59"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tvTanggalEventTiket"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/nunito_semibold"
                            android:text="12 - 15 Oktober 2026"
                            android:textColor="#20263A"
                            android:textSize="12sp" />

                        <!-- ID lama dipertahankan untuk data Room -->
                        <TextView
                            android:id="@+id/tvLokasiEventTiket"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:text="Lokasi event" />

                        <TextView
                            android:id="@+id/tvHargaEventTiket"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:text="Harga tiket" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PILIH KATEGORI TIKET -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/nunito_extrabold"
                android:text="Pilih Kategori Tiket"
                android:textColor="#20263A"
                android:textSize="16sp" />

            <!-- REGULAR PASS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#EAE8F3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <View
                        android:id="@+id/indicatorRegular"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="#D9D9D9" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="Regular Pass"
                            android:textColor="#20263A"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvHargaRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="Rp. 25.000"
                            android:textColor="#FF6B6B"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_regular"
                            android:text="Akses masuk 1 hari penuh"
                            android:textColor="#705D59"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnMinusRegular"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@android:drawable/ic_delete"
                        android:contentDescription="Kurangi tiket regular"
                        app:tint="#B8B8B8" />

                    <TextView
                        android:id="@+id/tvJumlahRegular"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:fontFamily="@font/nunito_extrabold"
                        android:text="0"
                        android:textColor="#20263A"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/btnPlusRegular"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@android:drawable/ic_input_add"
                        android:contentDescription="Tambah tiket regular"
                        app:tint="#FF6B6B" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- VIP + MERCHANDISE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#EAE8F3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <View
                        android:id="@+id/indicatorVip"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="#D9D9D9" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="VIP + Merchandise"
                            android:textColor="#20263A"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvHargaVip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="Rp. 75.000"
                            android:textColor="#FF6B6B"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_regular"
                            android:text="Akses masuk 1 hari + merchandise"
                            android:textColor="#705D59"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnMinusVip"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@android:drawable/ic_delete"
                        android:contentDescription="Kurangi tiket VIP"
                        app:tint="#B8B8B8" />

                    <TextView
                        android:id="@+id/tvJumlahVip"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:fontFamily="@font/nunito_extrabold"
                        android:text="0"
                        android:textColor="#20263A"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/btnPlusVip"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@android:drawable/ic_input_add"
                        android:contentDescription="Tambah tiket VIP"
                        app:tint="#FF6B6B" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- BUNDLING VOUCHER UMKM -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBundling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#EAE8F3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <View
                        android:id="@+id/indicatorBundling"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="#D9D9D9" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="Bundling Voucher UMKM"
                            android:textColor="#20263A"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvHargaBundling"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="Rp. 50.000"
                            android:textColor="#FF6B6B"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_regular"
                            android:text="Akses masuk 1 hari + voucher UMKM"
                            android:textColor="#705D59"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnMinusBundling"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@android:drawable/ic_delete"
                        android:contentDescription="Kurangi tiket bundling"
                        app:tint="#B8B8B8" />

                    <TextView
                        android:id="@+id/tvJumlahBundling"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:fontFamily="@font/nunito_extrabold"
                        android:text="0"
                        android:textColor="#20263A"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/btnPlusBundling"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@android:drawable/ic_input_add"
                        android:contentDescription="Tambah tiket bundling"
                        app:tint="#FF6B6B" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- METODE PEMBAYARAN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/nunito_extrabold"
                android:text="Metode Pembayaran"
                android:textColor="#20263A"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMetodePembayaran"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#EAE8F3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvMetodeQris"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_qris_selected"
                            android:fontFamily="@font/nunito_semibold"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="10dp"
                            android:text="QRIS"
                            android:textColor="#20263A"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvMetodeBank"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="#F8F7FF"
                            android:fontFamily="@font/nunito_semibold"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="10dp"
                            android:text="Bank"
                            android:textColor="#705D59"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvMetodeEwallet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="#F8F7FF"
                            android:fontFamily="@font/nunito_semibold"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="10dp"
                            android:text="E-Wallet"
                            android:textColor="#705D59"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:id="@+id/ivDropdownMetode"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/arrow_down_float"
                            android:contentDescription="Pilihan pembayaran"
                            app:tint="#705D59" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- RINCIAN HARGA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/nunito_extrabold"
                android:text="Rincian Harga"
                android:textColor="#20263A"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRincianHarga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#EAE8F3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/nunito_regular"
                            android:text="Regular Pass"
                            android:textColor="#705D59"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvSubtotalRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_regular"
                            android:text="Rp. 0"
                            android:textColor="#705D59"
                            android:textSize="12sp" />
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/nunito_regular"
                            android:text="VIP + Merchandise"
                            android:textColor="#705D59"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvSubtotalVip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_regular"
                            android:text="Rp. 0"
                            android:textColor="#705D59"
                            android:textSize="12sp" />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/nunito_regular"
                            android:text="Bundling Voucher UMKM"
                            android:textColor="#705D59"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvSubtotalBundling"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_regular"
                            android:text="Rp. 0"
                            android:textColor="#705D59"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#EAE8F3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="Total Pembayaran"
                            android:textColor="#20263A"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvTotalPembayaran"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="Rp. 0"
                            android:textColor="#FF6B6B"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- TOMBOL BAYAR -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBayarSekarang"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#FF6B6B"
        android:fontFamily="@font/nunito_extrabold"
        android:text="Bayar Sekarang"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:cornerRadius="25dp"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
